{
  "name": "polars_iptools",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",

  // polars is a heavy compile; undersized Codespaces will thrash.
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },

  "features": {
    // 3.12 matches the default used by the CI workflows. uv manages the
    // other interpreters in the test matrix on demand.
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers-extra/features/uv:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},

    // First-party. Registers the anthropic.claude-code VS Code extension itself,
    // so it is deliberately absent from the extensions list below.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  // Named volumes keep the cargo registry and target dir off the bind mount,
  // which is both faster and survives a container rebuild.
  "mounts": [
    "source=polars-iptools-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=polars-iptools-target,target=${containerWorkspaceFolder}/target,type=volume",
    // Keeps Claude Code auth, history, and project memory across rebuilds.
    "source=polars-iptools-claude,target=/home/vscode/.claude,type=volume"
  ],

  // uv tool install drops binaries in ~/.local/bin, which is not on PATH by default.
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  },

  "onCreateCommand": ".devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "ms-python.python",
        "charliermarsh.ruff",
        "nefrob.vscode-just-syntax"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "rust-analyzer.cargo.features": "all"
      }
    }
  },

  "remoteUser": "vscode"
}
